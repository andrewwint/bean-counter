# Postgres connection. Never hardcoded in code — always read from env.
#   native Homebrew postgresql@18 on this machine:  port 5432
#   docker compose container (postgres:18):         port 5433 (5432 is taken)
DATABASE_URL=postgresql://localhost:5432/bean_counter

# The vitest suite uses its OWN database so it can truncate freely; it is
# created and dropped by test/global-setup.ts. Set KEEP_TEST_DB=1 to inspect it.
DATABASE_URL_TEST=postgresql://localhost:5432/bean_counter_test

PORT=3000
# Dev-only CORS origin (the Vite dev server). Not a wildcard.
CORS_ORIGIN=http://localhost:5173
