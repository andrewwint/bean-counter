# Copy to .env:  cp .env.example .env
#
# LOCAL DEVELOPMENT ONLY. Every value below is a throwaway placeholder for a Postgres container
# on your laptop. Never reuse any of it for a deployed environment, and never commit a real
# credential — .env is gitignored, this file is not.

# Backend -> Postgres. Must match POSTGRES_* below (host port = POSTGRES_PORT).
# To use a native Postgres 18 instead of the container, point this at it — for example
# postgresql://localhost:5432/bean_counter — and skip `make db-up`. See the README.
DATABASE_URL=postgres://beancounter:localdev@localhost:5433/beancounter

# Consumed by docker-compose.yml when it starts the Postgres container.
POSTGRES_USER=beancounter
POSTGRES_PASSWORD=localdev
POSTGRES_DB=beancounter

# Host port the container publishes. 5432 is commonly already taken by a native Postgres
# (Homebrew postgresql@18, Postgres.app), so the container defaults out of the way to 5433.
# If nothing else is listening on 5432 you can set this to 5432 and update DATABASE_URL.
POSTGRES_PORT=5433

# Backend HTTP port.
PORT=3000

# Frontend -> backend. Vite exposes VITE_* vars to browser code, so never put a secret here.
VITE_API_URL=http://localhost:3000
